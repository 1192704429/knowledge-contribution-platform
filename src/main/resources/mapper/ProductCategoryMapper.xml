<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kp.mall.module.product_category.mapper.ProductCategoryMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND productCategory.id = #{entity.id}
            </if>
            <if test="entity.categoryName != null and entity.categoryName != ''">
                AND productCategory.category_name LIKE CONCAT('%', #{entity.categoryName}, '%')
            </if>
            <if test="entity.status != null">
                AND productCategory.status = #{entity.status}
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.kp.mall.module.product_category.entity.ProductCategory">
        SELECT productCategory.*
        FROM product_category productCategory
        <include refid="whereCondition"/>
        ORDER BY productCategory.sort ASC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM product_category productCategory
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.kp.mall.module.product_category.entity.ProductCategory">
        SELECT productCategory.*
        FROM product_category productCategory
        <include refid="whereCondition"/>
        ORDER BY productCategory.sort ASC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.kp.mall.module.product_category.entity.ProductCategory">
        SELECT productCategory.*
        FROM product_category productCategory
        WHERE productCategory.id = #{id}
    </select>

</mapper>
