<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kp.mall.module.order_info.mapper.OrderInfoMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND orderInfo.id = #{entity.id}
            </if>
            <if test="entity.orderCode != null and entity.orderCode != ''">
                AND orderInfo.order_code LIKE CONCAT('%', #{entity.orderCode}, '%')
            </if>
            <if test="entity.userId != null">
                AND orderInfo.user_id = #{entity.userId}
            </if>
            <if test="entity.payType != null">
                AND orderInfo.pay_type = #{entity.payType}
            </if>
            <if test="entity.payStatus != null">
                AND orderInfo.pay_status = #{entity.payStatus}
            </if>
            <if test="entity.orderStatus != null">
                AND orderInfo.order_status = #{entity.orderStatus}
            </if>
            <if test="entity.userName != null and entity.userName != ''">
                AND user.user_name LIKE CONCAT('%', #{entity.userName}, '%')
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.kp.mall.module.order_info.entity.OrderInfo">
        SELECT orderInfo.*
        , user.user_name AS userName
        FROM order_info orderInfo
        LEFT JOIN user user ON orderInfo.user_id = user.id
        <include refid="whereCondition"/>
        ORDER BY orderInfo.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM order_info orderInfo
        LEFT JOIN user user ON orderInfo.user_id = user.id
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.kp.mall.module.order_info.entity.OrderInfo">
        SELECT orderInfo.*
        , user.user_name AS userName
        FROM order_info orderInfo
        LEFT JOIN user user ON orderInfo.user_id = user.id
        <include refid="whereCondition"/>
        ORDER BY orderInfo.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.kp.mall.module.order_info.entity.OrderInfo">
        SELECT orderInfo.*
        , user.user_name AS userName
        FROM order_info orderInfo
        LEFT JOIN user user ON orderInfo.user_id = user.id
        WHERE orderInfo.id = #{id}
    </select>

</mapper>
