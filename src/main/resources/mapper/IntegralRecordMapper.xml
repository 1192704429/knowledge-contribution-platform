<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kp.mall.module.integral_record.mapper.IntegralRecordMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND integralRecord.id = #{entity.id}
            </if>
            <if test="entity.userId != null">
                AND integralRecord.user_id = #{entity.userId}
            </if>
            <if test="entity.integralType != null">
                AND integralRecord.integral_type = #{entity.integralType}
            </if>
            <if test="entity.integralSource != null">
                AND integralRecord.integral_source = #{entity.integralSource}
            </if>
            <if test="entity.userName != null and entity.userName != ''">
                AND user.user_name LIKE CONCAT('%', #{entity.userName}, '%')
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.kp.mall.module.integral_record.entity.IntegralRecord">
        SELECT integralRecord.*
        , user.user_name AS userName
        FROM integral_record integralRecord
        LEFT JOIN user user ON integralRecord.user_id = user.id
        <include refid="whereCondition"/>
        ORDER BY integralRecord.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM integral_record integralRecord
        LEFT JOIN user user ON integralRecord.user_id = user.id
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.kp.mall.module.integral_record.entity.IntegralRecord">
        SELECT integralRecord.*
        , user.user_name AS userName
        FROM integral_record integralRecord
        LEFT JOIN user user ON integralRecord.user_id = user.id
        <include refid="whereCondition"/>
        ORDER BY integralRecord.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.kp.mall.module.integral_record.entity.IntegralRecord">
        SELECT integralRecord.*
        , user.user_name AS userName
        FROM integral_record integralRecord
        LEFT JOIN user user ON integralRecord.user_id = user.id
        WHERE integralRecord.id = #{id}
    </select>

</mapper>
