<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kp.mall.module.admin.mapper.AdminMapper">

    <sql id="whereCondition">
        <where>
            <if test="entity.id != null">
                AND admin.id = #{entity.id}
            </if>
            <if test="entity.adminAccount != null and entity.adminAccount != ''">
                AND admin.admin_account LIKE CONCAT('%', #{entity.adminAccount}, '%')
            </if>
            <if test="entity.gender != null">
                AND admin.gender = #{entity.gender}
            </if>
            <if test="entity.adminName != null and entity.adminName != ''">
                AND admin.admin_name LIKE CONCAT('%', #{entity.adminName}, '%')
            </if>
            <if test="entity.roleType != null and entity.roleType != ''">
                AND admin.role_type = #{entity.roleType}
            </if>
            <if test="entity.status != null">
                AND admin.status = #{entity.status}
            </if>
        </where>
    </sql>

    <!-- 分页查询 -->
    <select id="pageQuery" resultType="com.kp.mall.module.admin.entity.Admin">
        SELECT admin.*
        FROM admin admin
        <include refid="whereCondition"/>
        ORDER BY admin.create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询总数 -->
    <select id="countQuery" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM admin admin
        <include refid="whereCondition"/>
    </select>

    <!-- 列表查询（不分页） -->
    <select id="listQuery" resultType="com.kp.mall.module.admin.entity.Admin">
        SELECT admin.*
        FROM admin admin
        <include refid="whereCondition"/>
        ORDER BY admin.create_time DESC
    </select>

    <!-- 根据ID查询 -->
    <select id="getById" resultType="com.kp.mall.module.admin.entity.Admin">
        SELECT admin.*
        FROM admin admin
        WHERE admin.id = #{id}
    </select>

</mapper>
